---
// HistorialTransacciones.astro
---

<div class="historial-container">
  <h2>📋 Historial de Transacciones</h2>

  <div class="tabla-wrapper">
    <table>
      <thead>
        <tr>
          <th>Tipo</th>
          <th>Monto</th>
          <th>Estado</th>
          <th>Hash Blockchain</th>
        </tr>
      </thead>
      <tbody id="tabla-transacciones-body">
        <tr>
          <td colspan="4" class="loading-text">Cargando transacciones...</td>
        </tr>
      </tbody>
    </table>
  </div>
</div>

<style>
  .historial-container {
    background: #18181b;
    border: 1px solid #27272a;
    border-radius: 12px;
    padding: 24px;
    margin-top: 32px;
    width: 100%;
    max-w: 896px;
    box-sizing: border-box;
  }
  h2 {
    color: #ffffff;
    font-size: 1.25rem;
    font-weight: 700;
    margin-bottom: 16px;
  }
  .tabla-wrapper {
    overflow-x: auto;
    width: 100%;
  }
  table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
    font-size: 0.875rem;
    color: #a1a1aa;
  }
  thead {
    background: #09090b;
    color: #e4e4e7;
    font-size: 0.75rem;
    text-transform: uppercase;
  }
  th, td {
    padding: 12px 16px;
    border-bottom: 1px solid #27272a;
  }
  tr:hover {
    background: rgba(39, 39, 42, 0.3);
  }
  .loading-text {
    text-align: center;
    color: #71717a;
    padding: 32px 0;
  }
  .badge {
    padding: 4px 10px;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 500;
    text-transform: capitalize;
  }
  .badge-pendiente { background: rgba(234, 179, 8, 0.1); color: #facc15; border: 1px solid rgba(234, 179, 8, 0.2); }
  .badge-completado { background: rgba(34, 197, 94, 0.1); color: #4ade80; border: 1px solid rgba(34, 197, 94, 0.2); }
  .badge-rechazado { background: rgba(239, 68, 68, 0.1); color: #f87171; border: 1px solid rgba(239, 68, 68, 0.2); }
</style>

<script>
  import { createClient } from '@supabase/supabase-js';

  const supabaseUrl = (import.meta.env.PUBLIC_SUPABASE_URL || import.meta.env.SUPABASE_URL) as string;
  const supabaseAnonKey = (import.meta.env.PUBLIC_SUPABASE_ANON_KEY || "") as string;
  const supabase = createClient(supabaseUrl, supabaseAnonKey);

  async function cargarHistorial() {
    const tbody = document.getElementById('tabla-transacciones-body');
    if (!tbody) return;

    try {
      const { data: { session } } = await supabase.auth.getSession();
      
      if (!session) {
        tbody.innerHTML = `<tr><td colspan="4" style="text-align: center; color: #f87171;">Inicia sesión para ver tu historial.</td></tr>`;
        return;
      }

      const res = await fetch('/api/obtener-transacciones', {
        headers: {
          'Authorization': `Bearer ${session.access_token}`
        }
      });

      const data = await res.json();
      if (!res.ok || !data.success) throw new Error(data.error || 'Error backend');

      const txs = data.transacciones;
      if (!txs || txs.length === 0) {
        tbody.innerHTML = `<tr><td colspan="4" style="text-align: center; color: #71717a;">Aún no registras ninguna transacción.</td></tr>`;
        return;
      }

      tbody.innerHTML = txs.map((tx: any) => {
        let badgeClass = 'badge-pendiente';
        if (tx.estado === 'completado') badgeClass = 'badge-completado';
        if (tx.estado === 'rechazado') badgeClass = 'badge-rechazado';

        const hashCorto = tx.hash_blockchain 
          ? `${tx.hash_blockchain.substring(0, 6)}...${tx.hash_blockchain.substring(tx.hash_blockchain.length - 4)}`
          : '—';

        const linkHash = tx.hash_blockchain 
          ? `<a href="https://bscscan.com/tx/${tx.hash_blockchain}" target="_blank" style="color: #818cf8; text-decoration: underline;">${hashCorto}</a>`
          : '—';

        return `
          <tr>
            <td style="color: #ffffff; font-weight: 500; text-transform: capitalize;">${tx.tipo}</td>
            <td style="color: #ffffff; font-family: monospace;">${parseFloat(tx.monto_virtual || 0).toFixed(2)} CASH</td>
            <td><span class="badge ${badgeClass}">${tx.estado || 'pendiente'}</span></td>
            <td style="font-family: monospace; font-size: 0.75rem;">${linkHash}</td>
          </tr>
        `;
      }).join('');

    } catch (err: any) {
      console.error(err);
      tbody.innerHTML = `<tr><td colspan="4" style="text-align: center; color: #f87171;">Error al cargar el historial (${err.message}).</td></tr>`;
    }
  }

  cargarHistorial();
</script>