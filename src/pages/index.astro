html_content = """
<!-- ========================================== -->
<!-- SECCIÓN DE STAKING Y REFERIDOS (INTEGRACIÓN) -->
<!-- ========================================== -->

<section class="crypto-features-section">
  <div class="features-container">
    
    <!-- Bloque de Staking -->
    <div class="feature-card staking-card">
      <div class="card-icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <line x1="12" y1="1" x2="12" y2="23"></line>
          <path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"></path>
        </svg>
      </div>
      <span class="badge">Rendimiento Fijo</span>
      <h2>Sistema de Staking</h2>
      <p class="percentage">20% <span class="period">Mensual</span></p>
      <p class="description">
        Haz que tus tokens trabajen para ti de forma automática. Al bloquear tus activos de manera segura en nuestra plataforma, aseguras un impresionante rendimiento mensual, permitiéndote generar ingresos pasivos constantes, estables y 100% predecibles.
      </p>
      <a href="#" class="cta-button">Empezar a ganar</a>
    </div>

    <!-- Bloque de Referidos -->
    <div class="feature-card referral-card">
      <div class="card-icon">
        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"></path>
          <circle cx="9" cy="7" r="4"></circle>
          <path d="M23 21v-2a4 4 0 0 0-3-3.87"></path>
          <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
        </svg>
      </div>
      <span class="badge badge-accent">Programa de Socios</span>
      <h2>Sistema de Referidos</h2>
      <p class="percentage">25% <span class="period">De ganancias</span></p>
      <p class="description">
        Multiplica tus ingresos impulsando nuestra comunidad. Comparte tu enlace de invitación personalizado y recibe comisiones directas equivalentes al 25% de todas las ganancias netas que generen tus invitados dentro del ecosistema.
      </p>
      <a href="#" class="cta-button cta-accent">Invitar amigos</a>
    </div>

  </div>
</section>

<style>
/* ========================================== */
/* ESTILOS CSS REUTILIZABLES E INDEPENDIENTES */
/* ========================================== */

.crypto-features-section {
  padding: 60px 20px;
  font-family: 'Segoe UI', system-ui, -apple-system, sans-serif;
  background-color: transparent; /* Se adapta al fondo de tu web */
  color: #ffffff;
}

.features-container {
  max-width: 1100px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
  gap: 30px;
}

/* Tarjeta Base */
.feature-card {
  background: rgba(30, 30, 40, 0.6);
  border: 1px solid rgba(255, 255, 255, 0.08);
  border-radius: 20px;
  padding: 40px 30px;
  backdrop-filter: blur(10px);
  -webkit-backdrop-filter: blur(10px);
  box-shadow: 0 10px 30px rgba(0, 0, 0, 0.2);
  transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  position: relative;
  overflow: hidden;
}

.feature-card:hover {
  transform: translateY(-5px);
  border-color: rgba(255, 255, 255, 0.15);
  box-shadow: 0 15px 40px rgba(0, 0, 0, 0.3);
}

/* Iconos */
.card-icon {
  width: 50px;
  height: 50px;
  background: rgba(255, 255, 255, 0.05);
  border-radius: 12px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20px;
}

.card-icon svg {
  width: 26px;
  height: 26px;
  stroke: #4f46e5; /* Color por defecto */
}

.staking-card .card-icon svg { stroke: #10b981; } /* Verde para dinero/staking */
.referral-card .card-icon svg { stroke: #3b82f6; } /* Azul para red/referidos */

/* Badges / Etiquetas */
.badge {
  font-size: 0.75rem;
  text-transform: uppercase;
  letter-spacing: 1px;
  padding: 4px 10px;
  border-radius: 50px;
  background: rgba(16, 185, 129, 0.15);
  color: #10b981;
  font-weight: 700;
  margin-bottom: 15px;
}

.badge-accent {
  background: rgba(59, 130, 246, 0.15);
  color: #3b82f6;
}

/* Tipografía */
.feature-card h2 {
  font-size: 1.6rem;
  margin: 0 0 10px 0;
  font-weight: 600;
  color: #ffffff;
}

.percentage {
  font-size: 2.5rem;
  font-weight: 800;
  margin: 10px 0 20px 0;
  line-height: 1;
  color: #ffffff;
}

.percentage .period {
  font-size: 1rem;
  font-weight: 400;
  opacity: 0.7;
  display: inline-block;
  margin-left: 5px;
}

.staking-card .percentage { color: #10b981; }
.referral-card .percentage { color: #3b82f6; }

.description {
  font-size: 0.95rem;
  line-height: 1.6;
  color: #b3b3b3;
  margin: 0 0 30px 0;
  flex-grow: 1; /* Empuja el botón siempre al fondo */
}

/* Botones de Acción (CTA) */
.cta-button {
  width: 100%;
  padding: 14px 24px;
  border-radius: 12px;
  font-weight: 600;
  font-size: 1rem;
  text-align: center;
  text-decoration: none;
  transition: background 0.2s ease, transform 0.2s ease;
  box-sizing: border-box;
}

.staking-card .cta-button {
  background: #10b981;
  color: #000000;
}
.staking-card .cta-button:hover {
  background: #059669;
}

.referral-card .cta-button {
  background: #3b82f6;
  color: #ffffff;
}
.referral-card .cta-button:hover {
  background: #2563eb;
}

/* Responsive Ajustado */
@media (max-width: 480px) {
  .feature-card {
    padding: 30px 20px;
  }
  .percentage {
    font-size: 2.2rem;
  }
}
</style>

</Layout>

<style>
	section{
		text-align:center;
		height:50dvh;
		display:flex;
		flex-direction:column;
		justify-content:center;
	
	}
	.hero h1{
		font-size:4rem;
		color:var(--primary);
		text-shadow: 0px 4px 10px rgba(0,0,0,0.5);
	}
	.hero p {
		font-size: 1.1rem;
		margin-top: -10px;
	}
	section:nth-child(2){
		flex-direction: unset;
		padding:2rem;
		text-align:center;
	}
	
</style>

<script>
  import { createClient } from '@supabase/supabase-js';

  function iniciarAuth() {
    const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
    const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;

    // En lugar de usar "return" suelto, metemos la lógica válida dentro del bloque if
    if (supabaseUrl && supabaseAnonKey) {
      const supabase = createClient(supabaseUrl, supabaseAnonKey);
      const googleBtn = document.getElementById('btn-google');

      if (googleBtn) {
        googleBtn.addEventListener('click', async () => {
          console.log("🚀 Botón clickeado, iniciando OAuth...");
          
          const { error } = await supabase.auth.signInWithOAuth({
            provider: 'google',
            options: {
              redirectTo: `${window.location.origin}/auth/callback`,
            },
          });

          if (error) {
            console.error('❌ Error de Supabase OAuth:', error.message);
          }
        });
      } else {
        console.error("❌ No se encontró el elemento con id 'btn-google' en el DOM.");
      }
    } else {
      console.error("❌ Error: Las variables de entorno de Supabase no están llegando al cliente.");
    }
  }

	// Ejecutar al cargar la página
	if ('Notification' in window) {
			Notification.requestPermission()
		}
      
  document.addEventListener('DOMContentLoaded', iniciarAuth);
</script>