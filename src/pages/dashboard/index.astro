---
import Layout from "../../layouts/Layout.astro";
import HistorialTransacciones from "../../components/HistorialTransacciones.astro";
---

<Layout>
  <div class="wallet-grid">
    <div class="card selector-card" style="grid-column: 1 / -1; margin-bottom: -10px;">
      <label for="global-network-select" style="font-weight: bold; color: #f4f4f5; display: block; margin-bottom: 8px;">
        🌐 Selecciona la Red Blockchain:
      </label>
      <select id="global-network-select" class="styled-select">
        <option value="">Cargando redes disponibles...</option>
      </select>
    </div>

    <div class="card deposit-card">
      <h3>Depositar Fondos (<span class="current-network-title">USDT</span>)</h3>
      <div
        class="debug-user-container"
        style="margin-bottom: 12px; font-size: 0.8rem; color: #71717a;"
      >
        <span>ID de Usuario Activo: </span>
        <strong
          id="debug-user-id"
          style="font-family: monospace; color: #a1a1aa;">Cargando ID...</strong
        >
        <span>Balance Virtual: </span>
        <strong
          id="balance_virtual"
          style="font-family: monospace; color: #a1a1aa;"
        >
        </strong>
        <p class="info-text">
          Envía USDT a tu dirección personal de depósito. Los fondos se
          acreditarán automáticamente en unos minutos.
        </p>

        <div class="deposit-address-container">
          <label>Tu Dirección de Depósito:</label>
          <div class="address-box">
            <span id="deposit-address-text">Cargando dirección...</span>
            <button id="btn-copy-address" title="Copiar dirección">📋</button>
          </div>
        </div>

        <div class="qr-container">
          <img
            id="deposit-qr"
            src=""
            alt="Código QR de depósito"
            style="display: none;"
          />
          <div id="qr-placeholder" class="qr-placeholder">Generando QR...</div>
        </div>

        <div id="network-badge-alert" class="network-badge">
          ⚠️ Red requerida: <strong id="current-badge-name">Selecciona una red</strong>
        </div>
      </div>
    </div>
    <div class="card withdraw-card">
      <h3>Retirar Fondos (<span class="current-network-title">USDT</span>)</h3>
      <p class="warning-text">
        El retiro se procesará de forma automática o manual según las reglas de la red seleccionada.
      </p>

      <form id="form-withdrawal" class="withdraw-form">
        <div class="form-group">
          <label for="withdraw-address">Dirección de Destino (EVM Wallet)</label>
          <input
            type="text"
            id="withdraw-address"
            placeholder="0x..."
            required
          />
        </div>

        <div class="form-group">
          <label for="withdraw-amount">Monto a Retirar (Min. 10 CASH)</label>
          <input
            type="number"
            id="withdraw-amount"
            min="10"
            step="0.01"
            placeholder="0.00"
            required
          />
        </div>

        <button type="submit" id="btn-withdraw">Solicitar Retiro</button>
      </form>
      <p id="withdraw-msg" class="msg-box"></p>
    </div>
    <div class="transacciones">
      <h2>Últimas Transacciones</h2>
      <HistorialTransacciones />
    </div>
  </div>

  <style>
    .styled-select {
      width: 100%;
      background: #09090b;
      border: 1px solid #27272a;
      color: #fff;
      padding: 12px;
      border-radius: 6px;
      font-size: 1rem;
      cursor: pointer;
    }
    .styled-select:focus {
      border-color: #ff6b6b;
      outline: none;
    }
    .withdraw-form {
      display: flex;
      flex-direction: column;
      gap: 15px;
    }
    .form-group {
      display: flex;
      flex-direction: column;
      gap: 5px;
    }
    .form-group label {
      font-size: 0.85rem;
      color: #aaa;
    }
    .form-group input {
      background: #111;
      border: 1px solid #333;
      color: #fff;
      padding: 12px;
      border-radius: 6px;
      font-size: 1rem;
    }
    .form-group input:focus {
      border-color: #ff6b6b;
      outline: none;
    }
    #btn-withdraw {
      background: #ff6b6b;
      color: white;
      border: none;
      padding: 12px;
      border-radius: 6px;
      font-weight: bold;
      font-size: 1rem;
      cursor: pointer;
      transition: background 0.2s;
      margin-top: 10px;
    }
    #btn-withdraw:hover {
      background: #fa5252;
    }
    .msg-box {
      margin-top: 10px;
      font-size: 0.9rem;
      font-weight: bold;
      text-align: center;
    }
    .msg-success {
      color: #51cf66;
    }
    .msg-error {
      color: #ff6b6b;
    }

    /**estilos de deposit card y general cards */
    .selector-card, .deposit-card, .withdraw-card {
      background: #18181b;
      border: 1px solid #27272a;
      border-radius: 12px;
      padding: 24px;
    }
    .info-text, .warning-text {
      font-size: 0.9rem;
      color: #a1a1aa;
      margin-bottom: 20px;
    }
    .deposit-address-container {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin-bottom: 20px;
    }
    .deposit-address-container label {
      font-size: 0.85rem;
      color: #71717a;
    }
    .address-box {
      display: flex;
      align-items: center;
      background: #09090b;
      border: 1px solid #27272a;
      border-radius: 6px;
      padding: 10px 14px;
      gap: 10px;
    }
    #deposit-address-text {
      font-family: monospace;
      font-size: 0.9rem;
      color: #f4f4f5;
      word-break: break-all;
      flex-grow: 1;
    }
    #btn-copy-address {
      background: #27272a;
      border: none;
      color: white;
      padding: 6px 10px;
      border-radius: 4px;
      cursor: pointer;
      transition: background 0.2s;
    }
    #btn-copy-address:hover {
      background: #3f3f46;
    }
    .qr-container {
      display: flex;
      justify-content: center;
      align-items: center;
      margin: 20px 0;
    }
    #deposit-qr {
      width: 160px;
      height: 160px;
      border: 6px solid white;
      border-radius: 6px;
    }
    .qr-placeholder {
      width: 160px;
      height: 160px;
      background: #09090b;
      border: 1px dashed #27272a;
      display: flex;
      justify-content: center;
      align-items: center;
      color: #52525b;
      font-size: 0.85rem;
      border-radius: 6px;
    }
    .network-badge {
      background: rgba(234, 179, 8, 0.1);
      color: #facc15;
      border: 1px solid rgba(234, 179, 8, 0.2);
      padding: 10px;
      border-radius: 6px;
      font-size: 0.8rem;
      text-align: center;
    }
  </style>

  <script>
    import { createClient } from "@supabase/supabase-js";

    const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL;
    const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY;
    const supabaseCliente = createClient(supabaseUrl, supabaseAnonKey);

    // Variables de control de UI
    const networkSelect = document.getElementById("global-network-select") as HTMLSelectElement;
    const badgeName = document.getElementById("current-badge-name");
    const networkTitles = document.querySelectorAll(".current-network-title");

    // Almacén local de redes mapeadas
    let redesMapeadas: any[] = [];

    async function inicializarDashboard() {
      // 1. Validamos la sesión del usuario
      const { data: { session } } = await supabaseCliente.auth.getSession();
      if (!session) {
        const addressText = document.getElementById("deposit-address-text");
        if (addressText) addressText.innerText = "Inicia sesión para ver tu información.";
        return;
      }

      // Pintamos el ID de usuario activo
      const debugUserText = document.getElementById("debug-user-id");
      if (debugUserText) debugUserText.innerText = session.user.id;

      // 2. Cargamos las redes configuradas en Supabase (redes_config con RLS activo)
      const { data: redes, error: redesError } = await supabaseCliente
        .from("redes_config")
        .select("nombre, slug")
        .eq("activa", true);

      if (redesError || !redes || redes.length === 0) {
        console.error("Error al cargar redes configuradas:", redesError);
        networkSelect.innerHTML = `<option value="">Error al cargar redes</option>`;
        return;
      }

      redesMapeadas = redes;

      // 3. Poblamos el elemento select
      networkSelect.innerHTML = redes.map((r, index) => 
        `<option value="${r.slug}" ${index === 0 ? 'selected' : ''}>${r.nombre}</option>`
      ).join("");

      // 4. Escuchamos cambios del selector para actualizar la interfaz
      networkSelect.addEventListener("change", () => {
        const selectedSlug = networkSelect.value;
        const redEncontrada = redesMapeadas.find(r => r.slug === selectedSlug);
        if (redEncontrada) {
          if (badgeName) badgeName.innerText = redEncontrada.nombre;
          networkTitles.forEach(el => (el.innerHTML = `USDT - ${redEncontrada.nombre}`));
        }
      });

      // Ejecutamos el primer trigger visual manual
      if (badgeName) badgeName.innerText = redes[0].nombre;
      networkTitles.forEach(el => (el.innerHTML = `USDT - ${redes[0].nombre}`));

      // 5. Cargamos datos de balances y wallet de depósito
      await cargarDatosBilletera(session.user.id);
    }

    async function cargarDatosBilletera(userId: string) {
      const addressText = document.getElementById("deposit-address-text");
      const qrImg = document.getElementById("deposit-qr") as HTMLImageElement;
      const qrPlaceholder = document.getElementById("qr-placeholder");
      const btnCopy = document.getElementById("btn-copy-address");
      const balance_virtual_html = document.getElementById("balance_virtual");

      if (!addressText || !qrImg || !qrPlaceholder || !balance_virtual_html) return;

      // Consultamos la dirección asignada
      const { data: walletData, error: walletError } = await supabaseCliente
        .from("billeteras_deposito")
        .select("direccion_publica")
        .eq("usuario_id", userId)
        .maybeSingle();

      if (walletError || !walletData) {
        addressText.innerText = "No tienes una dirección asignada.";
        qrPlaceholder.innerText = "Sin dirección";
        return;
      }

      const walletAddress = walletData.direccion_publica;
      addressText.innerText = walletAddress;

      // Generamos el QR de la Wallet EVM
      qrImg.src = `https://api.qrserver.com/v1/create-qr-code/?size=160x160&data=${walletAddress}`;
      qrImg.onload = () => {
        qrPlaceholder.style.display = "none";
        qrImg.style.display = "block";
      };

      // Listener para el botón copiar
      btnCopy?.addEventListener("click", () => {
        navigator.clipboard.writeText(walletAddress);
        const originalText = btnCopy.innerText;
        btnCopy.innerText = "✅";
        setTimeout(() => (btnCopy.innerText = originalText), 2000);
      });

      // Consultamos el balance virtual
      const { data: perfil } = await supabaseCliente
        .from("perfiles")
        .select("balance_virtual")
        .eq("id", userId)
        .maybeSingle();

      const balanceNumerico = parseFloat(perfil?.balance_virtual || "0");
      balance_virtual_html.innerText = `${balanceNumerico.toFixed(2)} USDT`;
    }

    // Lógica para enviar la solicitud de retiro (POST)
    document.getElementById("form-withdrawal")?.addEventListener("submit", async (e) => {
      e.preventDefault();

      const { data: { session } } = await supabaseCliente.auth.getSession();
      if (!session) return;

      const address = (document.getElementById("withdraw-address") as HTMLInputElement).value;
      const amount = parseFloat((document.getElementById("withdraw-amount") as HTMLInputElement).value);
      const redSlug = networkSelect.value; // Capturamos la red obligatoria del select global

      const msgBox = document.getElementById("withdraw-msg");
      const btn = document.getElementById("btn-withdraw") as HTMLButtonElement;

      if (!msgBox || !btn || !redSlug) return;

      btn.disabled = true;
      btn.innerText = "Procesando...";
      msgBox.className = "msg-box";
      msgBox.innerText = "";

      try {
        const response = await fetch("/api/solicitar-retiro", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ 
            usuarioId: session.user.id, 
            address, 
            amount, 
            redSlug // Enviamos la red dinámicamente al backend
          }),
        });

        const resData = await response.json();

        if (response.ok) {
          msgBox.classList.add("msg-success");
          msgBox.innerText = `¡Retiro solicitado con éxito! Transacción procesada correctamente.`;
          (document.getElementById("form-withdrawal") as HTMLFormElement).reset();
          
          // Refrescamos el balance virtual tras el descuento preventivo
          const balance_virtual_html = document.getElementById("balance_virtual");
          if (balance_virtual_html && resData.nuevoSaldo !== undefined) {
            balance_virtual_html.innerText = `${parseFloat(resData.nuevoSaldo).toFixed(2)} USDT`;
          }
        } else {
          throw new Error(resData.error || "Error desconocido");
        }
      } catch (err: any) {
        msgBox.classList.add("msg-error");
        msgBox.innerText = `❌ Error: ${err.message}`;
      } finally {
        btn.disabled = false;
        btn.innerText = "Solicitar Retiro";
      }
    });

    // Arrancamos el flujo
    inicializarDashboard();
  </script>
</Layout>