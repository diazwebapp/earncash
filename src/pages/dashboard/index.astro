---
import Layout from "../../layouts/Layout.astro";
import HistorialTransacciones from "../../components/HistorialTransacciones.astro";
---

<Layout>
    <div class="wallet-grid">
        <!-- TARJETA DE RETIRO -->
        <div class="card withdraw-card">
            <h3>Retirar Fondos (USDT BEP-20)</h3>
            <p class="warning-text">
                El retiro se procesará hacia la dirección que especifiques a
                continuación.
            </p>

            <form id="form-withdrawal" class="withdraw-form">
                <div class="form-group">
                    <label for="withdraw-address"
                        >Dirección de Destino (USDT BEP-20)</label
                    >
                    <input
                        type="text"
                        id="withdraw-address"
                        placeholder="0x..."
                        required
                    />
                </div>

                <div class="form-group">
                    <label for="withdraw-amount"
                        >Monto a Retirar (Min. 10 CASH)</label
                    >
                    <input
                        type="number"
                        id="withdraw-amount"
                        min="10"
                        step="0.01"
                        placeholder="0.00"
                        required
                    />
                </div>

                <button type="submit" id="btn-withdraw">Solicitar Retiro</button
                >
            </form>
            <p id="withdraw-msg" class="msg-box"></p>
        </div>
        <!-- FIN TARJETA DE RETIRO -->
    </div>

    <div class="transacciones">
        <h2>Últimas Transacciones</h2>
        <HistorialTransacciones/>
    </div>
</Layout>
<style>
    .withdraw-form {
  display: flex;
  flex-direction: column;
  gap: 15px;
}
.form-group {
  display: flex;
  flex-direction: column;
  gap: 5px;
}
.form-group label {
  font-size: 0.85rem;
  color: #aaa;
}
.form-group input {
  background: #111;
  border: 1px solid #333;
  color: #fff;
  padding: 12px;
  border-radius: 6px;
  font-size: 1rem;
}
.form-group input:focus {
  border-color: #ff6b6b;
  outline: none;
}
#btn-withdraw {
  background: #ff6b6b;
  color: white;
  border: none;
  padding: 12px;
  border-radius: 6px;
  font-weight: bold;
  font-size: 1rem;
  cursor: pointer;
  transition: background 0.2s;
  margin-top: 10px;
}
#btn-withdraw:hover {
  background: #fa5252;
}
.msg-box {
  margin-top: 10px;
  font-size: 0.9rem;
  font-weight: bold;
  text-align: center;
}
.msg-success { color: #51cf66; }
.msg-error { color: #ff6b6b; }
</style>
<script>
    // Lógica para enviar la solicitud de retiro
  document.getElementById('form-withdrawal')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    const address = (document.getElementById('withdraw-address') as HTMLInputElement).value;
    const amount = parseFloat((document.getElementById('withdraw-amount') as HTMLInputElement).value);
    const msgBox = document.getElementById('withdraw-msg');
    const btn = document.getElementById('btn-withdraw') as HTMLButtonElement;

    if (!msgBox || !btn) return;

    btn.disabled = true;
    btn.innerText = "Procesando...";
    msgBox.className = "msg-box";
    msgBox.innerText = "";

    try {
      // Pasamos de ejemplo el id del usuario simulado (luego se extrae de la sesión)
      const usuarioId = "ac585a84-d6ab-4f13-a5d2-df7557f8ddcb"; // Coloca el ID de tu tabla perfiles para probar

      const response = await fetch('/api/solicitar-retiro', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ usuarioId, address, amount })
      });

      const resData = await response.json();

      if (response.ok) {
        msgBox.classList.add('msg-success');
        msgBox.innerText = `¡Retiro solicitado con éxito! ID de transacción registrado.`;
        (document.getElementById('form-withdrawal') as HTMLFormElement).reset();
      } else {
        throw new Error(resData.error || 'Error desconocido');
      }
    } catch (err: any) {
      msgBox.classList.add('msg-error');
      msgBox.innerText = `❌ Error: ${err.message}`;
    } finally {
      btn.disabled = false;
      btn.innerText = "Solicitar Retiro";
    }
  });
</script>