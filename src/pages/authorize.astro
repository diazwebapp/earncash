---
import Layout from "../layouts/Layout.astro"
---

<Layout>
    <div class="container-loader">
        <h2>Autorice Earn Cash desde su dispositivo si es necesario</h2>

        <div class="spinner"></div>
    </div>
</Layout>

<style>
    .container-loader{
        height:100dvh;
        display:flex;
        align-items:center;
        justify-content:center;
        flex-direction:column;
    }
    .container-loader h2{
        margin-bottom:2rem;
    }
    /* Contenedor del Spinner */
        .spinner {
            width: 50px;
            height: 50px;
            border: 5px solid rgba(0, 0, 0, 0.1);
            border-top-color: #3498db; /* Color del borde animado */
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }

        /* Animación de rotación */
        @keyframes spin {
            to {
                transform: rotate(360deg);
            }
        }
</style>

<script>
    setTimeout(function(){
        alert("error del servidor")
    }, 1000)
</script>